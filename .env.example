# External backend API root.
# The frontend will call:
#   GET  {NEXT_PUBLIC_API_BASE_URL}/user
#   GET  {NEXT_PUBLIC_API_BASE_URL}/workouts
#   GET  {NEXT_PUBLIC_API_BASE_URL}/meals
#   GET  {NEXT_PUBLIC_API_BASE_URL}/stats?days=7
#   GET  {NEXT_PUBLIC_API_BASE_URL}/nutrition
#   GET  {NEXT_PUBLIC_API_BASE_URL}/progress
#   GET  {NEXT_PUBLIC_API_BASE_URL}/activity
#   GET  {NEXT_PUBLIC_API_BASE_URL}/coach
#
# Example for a backend running on port 8000:
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000/api"
